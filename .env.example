# Copy to .env (never commit .env). Blank = fill in; values shown are non-secret defaults.

# ---- Nebius Token Factory (models) ----
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_PROJECT_ID=project-e04crhvwbc00syvb9v6f5s
HF_TOKEN=

# ---- Tavily (live dataset search, spec file 03 §1.1) ----
TAVILY_API_KEY=

# ---- App ----
APP_MODE=live                      # live | replay
TRAINING_BACKEND=local             # local | jobs (Nebius AI Jobs, Phase 3)
DATA_DIR=./data
RUNS_DIR=./runs
DEMO_MONTHLY_VOLUME=
MAX_REPAIR_ROUNDS=
SANDBOX_BASE_URL=
CORS_ORIGINS=                      # comma-separated, e.g. https://synapse.vercel.app,http://localhost:5173

# ---- Specialist server / API keys ----
SPECIALIST_ENDPOINT_URL=
SPECIALIST_ADMIN_TOKEN=            # random string; the deployed endpoint uses the same value
API_KEY_PEPPER=                    # random string; changing it invalidates every specialist key

# ---- Supabase (Postgres + Auth with Google sign-in) ----
SUPABASE_URL=                      # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                 # publishable key (sb_publishable_...) or legacy anon JWT; public, the frontend uses it too
SUPABASE_SERVICE_ROLE_KEY=         # secret key (sb_secret_...) or legacy service_role JWT; backend only
SUPABASE_JWT_SECRET=               # only for legacy HS256 projects; projects with JWT signing keys (ES256) are verified via <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=                   # Connect → Session pooler URI (…pooler.supabase.com:5432); the direct db.<ref> host is IPv6-only

# ---- Nebius Object Storage (bucket created 2026-10-28; default storage class ENHANCED_THROUGHPUT) ----
OBJECT_STORAGE_ENDPOINT=https://storage.eu-west2.nebius.cloud
OBJECT_STORAGE_REGION=eu-west2
OBJECT_STORAGE_BUCKET=synapse-artifacts-e04crhvwbc
OBJECT_STORAGE_ACCESS_KEY=         # access key of the synapse-backend service account
OBJECT_STORAGE_SECRET_KEY=

# ---- Nebius AI Jobs and Container Registry (build workers) ----
NEBIUS_REGISTRY=cr.eu-west2.nebius.cloud/e04cjwm2bdv5k5b8hc
NEBIUS_SA_CREDENTIALS_FILE=        # path to the service account's credentials JSON (keep outside the repo)

# ---- Budgets (see docs/TEAM_PLAN.md §6; Token Factory $25, Nebius AI Cloud $25, Tavily $25) ----
CREDIT_BUDGET_USD=1.00             # Token Factory spend cap per build (Phase 2b builds cost $0.07 to $0.31)
DEMO_DAILY_BUDGET_USD=1.00         # Token Factory per day for public chat, compare and cascade escalations
USER_DAILY_BUILD_BUDGET_USD=1.00   # Token Factory per user per day for builds
GLOBAL_DAILY_BUILD_BUDGET_USD=3.00 # Token Factory per day for all users' builds
TOKEN_FACTORY_TOTAL_BUDGET_USD=17.00  # hard stop for live features ($25 minus $8 kept for the final recordings)
MAX_CONCURRENT_BUILDS=2            # all users (Token Factory rate limit is shared)
MAX_CONCURRENT_BUILDS_PER_USER=1
MAX_BUILDS_PER_USER_PER_DAY=3
WORKER_TOTAL_BUDGET_USD=6.00       # Nebius AI Cloud spend cap for build workers (AI Jobs)
TAVILY_MAX_SEARCHES_PER_BUILD=5
TAVILY_DAILY_SEARCH_LIMIT=100
