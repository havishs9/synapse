{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://port8000-b3arav7mmzek3n6.tunnel.applications.eu-west2.nebius.cloud/api/:path*" },
    { "source": "/v1/:path*", "destination": "https://port8000-b3arav7mmzek3n6.tunnel.applications.eu-west2.nebius.cloud/v1/:path*" },
    { "source": "/health", "destination": "https://port8000-b3arav7mmzek3n6.tunnel.applications.eu-west2.nebius.cloud/health" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
