# Copy to frontend/.env.local for local dev; set the same names in Vercel's project settings.
# Everything here ships to the browser: never put secrets in this file.
VITE_API_BASE_URL=                 # empty = same origin (local dev proxy); prod: the Nebius endpoint URL
VITE_SUPABASE_URL=                 # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=            # public anon key
VITE_AUTH_ENABLED=                 # empty = sign-in on when the two Supabase values are set; false turns it off
