{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://port8000-bwcm7xs18a6her4.tunnel.applications.eu-west2.nebius.cloud/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://port8000-bwcm7xs18a6her4.tunnel.applications.eu-west2.nebius.cloud/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://port8000-bwcm7xs18a6her4.tunnel.applications.eu-west2.nebius.cloud/health"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
